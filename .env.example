# ─── Core (required in production) ───────────────────────────────
# Postgres connection. Use the POOLED / IPv4-friendly connection string
# (e.g. Supabase Session pooler on port 5432 or Transaction pooler 6543).
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Secret used to sign session JWTs. Generate a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Node environment: development | production
NODE_ENV=development

# Port the standalone server listens on (production / dev API).
PORT=8787

# ─── AI Provider (optional — AI features disabled if unset) ──────
# OpenAI-compatible provider. Groq is the default (free at console.groq.com).
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Optional fallback provider (used if primary fails)
AI_FALLBACK_API_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# ─── Object Storage (optional — falls back to local disk if unset) ──
# Choose ONE: local | s3 | supabase.
#   local    -> dev only; NOT durable on Render (wiped on redeploy)
#   supabase -> durable; create a bucket in Supabase → Storage
#   s3       -> any S3-compatible provider
STORAGE_PROVIDER=supabase
# Supabase Storage:
SUPABASE_URL=https://xxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service-role-key
SUPABASE_BUCKET=documents
# S3-compatible (only if STORAGE_PROVIDER=s3):
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_STORAGE_DIR=./uploads

# ─── Payments (optional — billing disabled if unset) ────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# ─── Job Sources (optional — each disabled if its key is unset) ──
# Only ToS-compliant sources are supported. Add keys for sources you have
# legitimate API access to. Example placeholders:
JOBS_ADZUNA_APP_ID=
JOBS_ADZUNA_APP_KEY=
JOBS_USAJOBS_API_KEY=
JOBS_REMOTIVE_ENABLED=true       # Remotive has a public jobs API

# ─── Admin bootstrap (used by db:seed) ───────────────────────────
ADMIN_EMAIL=admin@theapplicant.local
ADMIN_PASSWORD=changeme123
